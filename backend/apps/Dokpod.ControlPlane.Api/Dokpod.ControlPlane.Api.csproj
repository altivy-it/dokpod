<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Dokpod.ControlPlane.Api</AssemblyName>
    <RootNamespace>Dokpod.ControlPlane.Api</RootNamespace>
  </PropertyGroup>

  <!-- Spec 031 D-009: edição fixada no build. Sem propriedade = CE; `-p:DokpodEdition=Business` compõe o licenciamento. -->
  <PropertyGroup Condition="'$(DokpodEdition)' == 'Business'">
    <DefineConstants>$(DefineConstants);DOKPOD_BUSINESS</DefineConstants>
  </PropertyGroup>

  <Target Name="ValidateDokpodEdition" BeforeTargets="BeforeBuild" Condition="'$(DokpodEdition)' != '' and '$(DokpodEdition)' != 'Business'">
    <Error Text="DokpodEdition aceita somente 'Business'; omita a propriedade para compilar a CE." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <!-- Fixa a dependência transitiva do MSBuild usado pelo EF Design (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); só design-time. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../libs/Dokpod.Agent.Contracts/Dokpod.Agent.Contracts.csproj" />
    <ProjectReference Include="../../libs/Dokpod.ControlPlane.Application/Dokpod.ControlPlane.Application.csproj" />
    <ProjectReference Include="../../libs/Dokpod.ControlPlane.Infrastructure/Dokpod.ControlPlane.Infrastructure.csproj" />
  </ItemGroup>
</Project>