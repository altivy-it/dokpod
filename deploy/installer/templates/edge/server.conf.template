# Dokpod {{VERSION}}: borda provisionada pelo instalador (spec 033, D-008), única porta HTTP pública.
map $http_upgrade $dokpod_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name {{SERVER_NAME}};

    ssl_certificate /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = / {
        return 302 /dokpod/;
    }

    include /etc/nginx/conf.d/dokpod.locations;
}
